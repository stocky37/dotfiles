# single letter aliases
alias e="$EDITOR"
alias v="$VISUAL"
alias g="git"
alias r='cd $(git root)'

# kustomize
alias kust=kustomize
alias kustinit=kustomize init --autodetect --recursive

# Common typos
alias gti=git
alias tnk=tkn

# misc commands
alias mkdir="mkdir -p"
alias path='echo $PATH | tr -s ":" "\n"'
alias gpg=gpg2
alias base64="base64 -w 0"
alias ssh-finger="ssh-keygen -l -E md5 -f"
alias kssh="kitty +kitten ssh"
